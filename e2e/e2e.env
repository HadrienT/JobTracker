# Environment for the e2e stack (docker-compose.e2e.yml). Nothing here is secret and
# nothing reaches a real source: the collector is not part of this stack.
JT_LOG_LEVEL=WARNING
JT_LOG_FORMAT=json
JT_API_HOST=0.0.0.0
JT_API_PORT=8100
JT_WEB_PORT=5199
JT_PUBLIC_API_BASE=/api
JT_LLM_ENABLED=false
JT_LLM_BASE_URL=http://127.0.0.1:8000/v1
JT_LLM_MODEL=none
JT_LLM_TIMEOUT_S=5
JT_USER_AGENT=JobTracker-e2e/0.1
JT_HTTP_TIMEOUT_S=5
JT_AGGREGATORS_ENABLED=false
