# An online, integrity-checked, gzipped SQLite backup of ./data/jobtracker.db into ./backups,
# plus an archive of ./data/career. Only the latest of each is kept (JT_BACKUP_KEEP=1): the
# previous one is deleted once the new one has been written and checked.
# Never `cp` a WAL database while it is open: this uses SQLite's `VACUUM INTO`.
[Unit]
Description=JobTracker: back up the database

[Service]
Type=oneshot
ExecStart=/bin/bash -lc 'cd %h/JobTracker && just backup'
Nice=10
