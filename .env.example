# JobTracker — copier en .env et renseigner.
# Référence complète : blueprint/06-CONFIG.md §1

# --- Base ---
JT_DB_PATH=./jobtracker.db

# --- Journalisation ---
JT_LOG_LEVEL=INFO
JT_LOG_FORMAT=json            # json | console

# --- API et front ---
JT_API_HOST=127.0.0.1
JT_API_PORT=8100
JT_WEB_PORT=5190
JT_PUBLIC_API_BASE=http://127.0.0.1:8100

# --- LLM local (llama-server, partagé avec OpenHands) ---
JT_LLM_ENABLED=false
JT_LLM_BASE_URL=http://127.0.0.1:8000/v1
JT_LLM_MODEL=Qwen3-Coder-30B-A3B-Instruct
JT_LLM_TIMEOUT_S=60

# --- HTTP ---
JT_USER_AGENT=JobTracker/0.1 (+https://github.com/HadrienT/JobTracker)
JT_HTTP_TIMEOUT_S=20

# --- Agrégateurs (WP13) — double verrou, désactivés par défaut ---
JT_AGGREGATORS_ENABLED=false
JT_ADZUNA_APP_ID=replace-me
JT_ADZUNA_APP_KEY=replace-me
JT_LINKEDIN_COOKIE=
